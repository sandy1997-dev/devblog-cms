# ─────────────────────────────────────────────────────────────────────────────
# DevBlog Environment Variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
# The full public URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Author ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTHOR_NAME="Your Name"
NEXT_PUBLIC_AUTHOR_EMAIL=you@example.com
NEXT_PUBLIC_TWITTER_HANDLE=@yourhandle
NEXT_PUBLIC_GITHUB_USERNAME=yourusername
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourhandle
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Vercel Analytics is enabled automatically when deployed on Vercel
# For self-hosted analytics, add your provider's credentials here:
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Search (optional) ─────────────────────────────────────────────────────────
# Built-in Fuse.js search is used by default (no config needed).
# For Algolia DocSearch, uncomment and fill in:
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
# NEXT_PUBLIC_ALGOLIA_INDEX_NAME=

# ── Comments (optional) ───────────────────────────────────────────────────────
# Add a comment provider like Giscus (GitHub Discussions-backed)
# NEXT_PUBLIC_GISCUS_REPO=user/repo
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=
